<% const library=quant_resources(),entries=library.entries,groups=[...new Set(entries.map(r=>r.category))],types=[...new Set(['代码',...entries.map(r=>r.type)])]; %>
<div class="page-wrap resource-library">
 <div class="eyebrow">学习资料</div><div class="page-heading"><h1>资料中心</h1><p>课程代码、书籍与课程、数据文档和研究资料。按学习内容查找，也可直接搜索名称。</p></div>
 <nav class="rh-guide" aria-label="资料类型"><a class="lab-card" href="#resource-downloads"><%- icon('download') %><div><strong>课程代码与附件</strong><span>示例程序、运行说明与结果</span></div></a><a class="lab-card" href="#resource-reading"><%- icon('book') %><div><strong>书籍、课程与研究资料</strong><span>按数学、编程和量化方向查找</span></div></a><a class="lab-card" href="/interview/experience/"><%- icon('arrow') %><div><strong>笔面试与求职准备</strong><span>岗位介绍、经验贴与时间安排</span></div></a></nav>
 <div class="resource-library-filters"><label class="resource-library-search"><span class="sr-only">搜索资料</span><input id="resource-query" type="search" placeholder="搜索书名、作者、课程、工具或数据"></label><label>类别<select id="resource-category"><option value="">全部类别</option><option>课程附件</option><% groups.forEach(g=>{ %><option><%= g %></option><% }) %></select></label><label>形式<select id="resource-type"><option value="">全部形式</option><% types.forEach(t=>{ %><option><%= t %></option><% }) %></select></label><label>阶段<select id="resource-level"><option value="">全部阶段</option><option>入门</option><option>基础</option><option>进阶</option></select></label><button type="button" id="resource-reset" class="button secondary">清除筛选</button></div>
 <p id="resource-status" class="muted" aria-live="polite"></p>
 <section class="rh-section" id="resource-downloads"><header><div><h2>课程代码与附件</h2><p>先阅读包内说明，再运行对应示例；单课附件也可在课程末尾下载。</p></div></header><div class="rh-groups"><% library.downloads.forEach(g=>{ %><article class="rh-group lab-card resource-download-group"><h3><%= g.title %></h3><p><%= g.description %></p><ul class="rh-list"><% g.entries.forEach(r=>{ %><li data-resource-item data-category="课程附件" data-type="代码"><a href="<%= r.url %>" <%- r.download?'download':'' %>><strong><%= r.title %></strong><span><%= r.description %></span></a><em class="rh-badge"><%= r.label %></em></li><% }) %></ul></article><% }) %></div></section>
 <section class="rh-section" id="resource-reading"><header><div><h2>书籍、课程与研究资料</h2><p>每项注明适用阶段、内容和访问方式。查阅日期：<%= library.checked %>。</p></div></header><nav class="resource-topic-nav" aria-label="资料主题"><% groups.forEach((g,i)=>{ %><a href="#resource-group-<%= i %>"><%= g %></a><% }) %></nav><div class="rh-groups"><% groups.forEach((g,i)=>{ %><article class="rh-group lab-card resource-reading-group" id="resource-group-<%= i %>"><h3><%= g %></h3><p><%= library.categories?.find(c=>c.name===g)?.description||'' %></p><ul class="rh-list"><% entries.filter(r=>r.category===g).forEach(r=>{ %><li data-resource-item data-category="<%= r.category %>" data-type="<%= r.type %>" data-level="<%= r.level %>"><div><a href="<%= r.url %>" <%- r.url.startsWith('/')?'':'target="_blank" rel="noopener noreferrer"' %>><strong><%= r.title %></strong></a><span class="resource-entry-meta"><%= r.type %> · <%= r.level %> · <%= r.access %></span><p><%= r.description %></p><% if(r.local_url){ %><a class="resource-local" href="<%= r.local_url %>">本站课程 →</a><% } %></div></li><% }) %></ul></article><% }) %></div></section>
 <p id="resource-empty" class="lab-empty" hidden>没有找到匹配资料，可减少筛选条件。</p>
</div>
