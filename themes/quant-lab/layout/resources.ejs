<% const library=quant_resources(),entries=library.entries,groups=[...new Set(entries.map(r=>r.category))],types=[...new Set(entries.map(r=>r.type))]; %>
<div class="page-wrap resource-library">
 <div class="eyebrow">学习资料</div><div class="page-heading"><h1>资料中心</h1><p>查找量化学习所需的书籍、课程、数据文档与研究资料。</p></div>
 <div class="resource-library-filters"><label class="resource-library-search"><span class="sr-only">搜索资料</span><input id="resource-query" type="search" placeholder="搜索书名、作者、课程、工具或数据"></label><label>类别<select id="resource-category"><option value="">全部类别</option><% groups.forEach(g=>{ %><option><%= g %></option><% }) %></select></label><label>形式<select id="resource-type"><option value="">全部形式</option><% types.forEach(t=>{ %><option><%= t %></option><% }) %></select></label><label>阶段<select id="resource-level"><option value="">全部阶段</option><option>入门</option><option>基础</option><option>进阶</option></select></label><button type="button" id="resource-reset" class="button secondary">清除筛选</button></div>
 <p id="resource-status" class="muted" aria-live="polite"></p>
 <section class="rh-section" id="resource-reading"><header><div><h2>书籍课程与研究资料</h2><p>按学科与研究方向分类，列出适用阶段、内容和访问方式。</p></div></header><nav class="resource-topic-nav" aria-label="资料主题"><% groups.forEach((g,i)=>{ %><a href="#resource-group-<%= i %>"><%= g %></a><% }) %></nav><div class="rh-groups"><% groups.forEach((g,i)=>{ const rows=entries.filter(r=>r.category===g); %><article class="rh-group resource-reading-group" id="resource-group-<%= i %>"><h3><%= g %> <span data-resource-count aria-label="资料数量"><%= rows.length %></span></h3><p><%= library.categories?.find(c=>c.name===g)?.description||'' %></p><ul class="rh-list"><% rows.forEach(r=>{ %><li data-resource-item data-category="<%= r.category %>" data-type="<%= r.type %>" data-level="<%= r.level %>"><div><a href="<%= r.url %>" <%- r.url.startsWith('/')?'':'target="_blank" rel="noopener noreferrer"' %>><strong><%= r.title %></strong></a><span class="resource-entry-meta"><%= r.type %> · <%= r.level %> · <%= r.access %></span><p><%= r.description %></p><% if(r.local_url){ %><a class="resource-local" href="<%= r.local_url %>">本站课程 →</a><% } %></div></li><% }) %></ul></article><% }) %></div></section>
 <p id="resource-empty" class="lab-empty" hidden>没有找到匹配资料，可减少筛选条件。</p>
</div>
