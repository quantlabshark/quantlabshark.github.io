<% const book=page.interview_book,zhou=book==='zhou',rows=interview_rows(book),chapters=interview_chapters(book); %>
<div class="page-wrap interview-book-page" data-interview-book="<%= book %>" data-lab-catalog="interview-<%= book %>" data-catalog-custom>
 <div class="eyebrow">QUANT INTERVIEWS / <%= zhou?'FOUNDATIONS':'RESEARCH & CODE' %></div>
 <header class="interview-book-header"><div><h1><%= page.title %></h1><p class="interview-lead"><%= page.description %></p><p class="muted"><%= zhou?'参考书：Xinfeng Zhou · A Practical Guide To Quantitative Finance Interviews':'资料集：QuantMaterial · 笔试练习与面经回忆' %></p></div><span class="interview-book-stamp"><b><%= zhou?'01':'02' %></b>READING COLLECTION</span></header>
 <div class="interview-book-toolbar"><span id="interview-count"><%= chapters.length %> 章 · <%= rows.length %> 节 · 题目与解答</span><a class="button" id="interview-start" href="/read/?slug=<%= rows[0]?.slug||'' %>">开始阅读 →</a><a class="text-link" href="/interview/">两册总览</a></div>
 <div class="interview-filters"><label class="search-field"><%- icon('search') %><input id="interview-query" type="search" placeholder="搜索题目或知识点" aria-label="搜索题目或知识点" maxlength="100"></label><label class="interview-filter-label">难度<select id="interview-difficulty"><option value="">全部难度</option><option>基础</option><option>进阶</option><option>挑战</option><option>综合</option></select></label><button class="button secondary" type="button" id="interview-expand" aria-expanded="false">展开全部</button></div>
 <div class="interview-catalog-layout"><aside class="interview-toc" aria-label="本册章节"><strong>本册目录</strong><nav id="interview-toc"><% chapters.forEach(c=>{ %><a href="#chapter-<%= c.number %>"><span><%= String(c.number).padStart(2,'0') %></span><%= c.title %></a><% }); %></nav><p>按章节或来源查阅题目与解答。</p></aside><div><p id="interview-result" class="muted" role="status" aria-live="polite"><%= rows.length %> 个阅读单元</p><div id="interview-catalog"><%- interview_catalog(book) %></div><p id="interview-empty" class="interview-source-note" hidden>没有匹配的题目。试试其他关键词或难度。</p><p id="interview-sync" class="muted" role="status"></p></div></div>
 <noscript><p class="interview-source-note">章节目录可直接浏览。搜索、筛选与登录阅读需要启用 JavaScript。</p></noscript>
 <div class="interview-source-note"><strong>资料来源</strong><p><%= zhou?'来源页码按 PDF 文件从 1 开始计数；一页 PDF 可能包含两页印刷页面。':'原记录缺失的条件在对应题目中注明，补充假设与原题区分。' %> <a href="/interview/sources/">查看来源清单 →</a></p></div>
</div>
