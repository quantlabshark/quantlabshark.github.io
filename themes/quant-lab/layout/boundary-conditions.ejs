<% const entries = boundary_conditions(); const categories = [...new Set(entries.map(item => item.category))]; %>
<div class="page-wrap fo-quick reference-catalog">
  <div class="eyebrow">边界条件索引 · v2512</div>
  <div class="page-heading">
    <h1>边界条件速查</h1>
    <p>按字段、物理场景或类型名称查找。各条目给出参数、配置示例和字段搭配；类型索引可继续查阅专用边界及官方定义。</p>
  </div>
  <nav class="fo-quick-links reference-links" aria-label="边界条件 学习入口">
    <a href="/boundary-conditions/usage/">先看文件结构与条件选择 →</a>
    <a href="/boundary-conditions/selection/">选择与搭配指南 →</a>
    <a href="/boundary-conditions/type-index/">全部类型索引 →</a>
    <a href="/quick-reference/">全部速查 →</a>
  </nav>
  <%- partial('_partial/reference-help', {search: "边界类型、速度与压力等字段、用途和配置参数。", usage: "先确定求解器、物理模型和边界场景，再核对字段量纲、网格边界名称与各场的搭配；打开详情查看参数、配置示例和配套源码。"}) %>
<label class="search-field"><%- icon('search') %><input id="fo-query" type="search" aria-label="搜索 边界条件" placeholder="输入名称、用途或参数，例如 noSlip、回流、温度、inletValue…"></label>
  <div class="filter-tabs" role="group" aria-label="边界条件 分类">
    <% ['全部', ...categories].forEach((category, index) => { %>
      <button type="button" data-fo-category="<%= category %>" class="<%= index === 0 ? 'selected' : '' %>" aria-pressed="<%= index === 0 %>"><%= category %></button>
    <% }); %>
  </div>
  <div class="fo-quick-results">
    <p class="result-count" id="fo-count" role="status">共 <%= entries.length %> 个配置条目</p>
    <label for="fo-sort">排序 <select id="fo-sort"><option value="common">常用优先</option><option value="name">名称 A–Z</option><option value="name-desc">名称 Z–A</option></select></label>
  </div>
  <div class="fo-quick-grid" id="fo-list" aria-label="边界条件列表"></div>
  <noscript><p>下列链接可直接打开各工具的参考页面。</p><ul><% entries.forEach(item => { %><li><a href="<%= item.url %>"><%= item.name %></a>：<%= item.description %></li><% }); %></ul></noscript>
</div>
