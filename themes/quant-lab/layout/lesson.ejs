<% const data=learning(); const lesson=data.lessons.find(l=>l.id===page.lesson_id); %><div class="article-shell"><article class="article"><div class="eyebrow">LESSON <%= String(lesson.id).padStart(2,'0') %> / 28 · <%= lesson.stageName %></div><h1><%= page.title %></h1><div class="article-meta"><span>建议学习 90 分钟</span><span>OpenFOAM v2512</span><a href="/downloads/lesson-<%= String(lesson.id).padStart(2,'0') %>.docx" download>下载本讲讲义 ↓</a><a href="/downloads/lesson-<%= String(lesson.id).padStart(2,'0') %>-cases.zip" download>下载配套算例 ↓</a></div><div class="prose"><%- page.content %></div><div class="lesson-actions"><button class="button" id="complete-lesson" data-id="<%= lesson.id %>">标记本讲已完成 <%- icon('check') %></button><a class="button secondary" href="/community/?lesson=<%= lesson.id %>">对本讲提问</a></div><div class="lesson-pagination"><% if(lesson.id>1){ %><a href="/lessons/<%= String(lesson.id-1).padStart(2,'0') %>/">← 上一讲<span><%= data.lessons[lesson.id-2].title %></span></a><% } else { %><a href="/start/">← 快速开始<span>运行前的准备</span></a><% } %><% if(lesson.id<28){ %><a href="/lessons/<%= String(lesson.id+1).padStart(2,'0') %>/">下一讲 →<span><%= data.lessons[lesson.id].title %></span></a><% } %></div></article><aside class="article-toc"><div>本讲目录</div><nav id="toc" aria-label="本讲目录"></nav><div class="toc-note">修改参数时应记录<br>依据、量纲与结果变化。</div></aside></div>
