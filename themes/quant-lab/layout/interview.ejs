<% const all=interview_rows(),zhou=interview_rows('zhou'),practice=interview_rows('practice'); %>
<div class="page-wrap interview-hub" data-lab-catalog="interview" data-catalog-custom>
 <section class="interview-hero">
  <div><div class="eyebrow">QUANTITATIVE FINANCE INTERVIEWS</div><h1>量化笔试与面试</h1><p class="interview-lead">概率统计、数学、金融、算法与研究分析题。解答默认收起，可在作答后展开核对。</p><div class="fl-actions"><a class="button" href="/interview/zhou/">教材目录 →</a><a class="button secondary" href="/interview/practice/">笔面试资料目录</a></div></div>
  <aside class="interview-summary"><span>QUESTION LIBRARY</span><strong data-interview-total><%= all.length %></strong><p>个阅读单元</p><div><span>2 册主题目录</span><span><%= interview_chapters('practice').filter(c=>c.title!=='其他').length %> 家公司</span></div></aside>
 </section>
 <div class="interview-section-heading"><h2>模块入口</h2></div>
 <div class="interview-books">
  <%- partial('_partial/interview-module-card',{card:{number:'01',label:'经典书籍题解',lines:['概率 · 数学','金融 · 算法'],caption:'基础题目与推导',title:'经典量化面试教材',description:'涵盖逻辑、数学、概率、随机过程、金融与数值方法，配有题目分析和解答。',tags:[zhou.length+' 节',interview_chapters('zhou').length+' 章','题目与解答'],href:'/interview/zhou/',action:'查看章节目录'}}) %>
  <%- partial('_partial/interview-module-card',{card:{number:'02',label:'笔面试实战',tone:'practice',lines:['统计 · 模型','代码 · 研究'],caption:'公司题目与分析',title:'量化笔面试资料',description:'按公司查阅概率统计、机器学习、编程、因子研究及数据分析题解。',tags:[practice.length+' 节',interview_chapters('practice').filter(c=>c.title!=='其他').length+' 家公司','代码与研究分析'],href:'/interview/practice/',action:'查看章节目录'}}) %>
  <%- partial('_partial/interview-module-card',{card:{number:'03',label:'求职准备',tone:'career',lines:['经验 · 岗位','计划 · 投递'],caption:'面试记录与准备安排',title:'经验与求职',description:'查阅公司面试记录和招聘要求，了解岗位职责，安排准备进度并记录投递情况。',tags:['公司经验','岗位介绍','准备时间线'],href:'/interview/experience/',action:'进入经验与求职'}}) %>
 </div>
</div>
