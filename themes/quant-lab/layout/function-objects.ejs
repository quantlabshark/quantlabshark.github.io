<% const entries = function_objects(); const categories = [...new Set(entries.map(item => item.category))]; %>
<div class="page-wrap fo-quick reference-catalog">
  <div class="eyebrow">函数对象索引 · v2512</div>
  <div class="page-heading">
    <h1>函数对象速查</h1>
    <p>按工具名称、用途或参数查找。每种功能对象都有独立的配置说明、参数表和示例。</p>
  </div>
  <nav class="fo-quick-links reference-links" aria-label="函数对象学习入口">
    <a href="/function-objects/usage/">配置方法与通用参数 →</a>
    <a href="/topics/function-objects/">专题课程与配套算例 →</a>
  </nav>
  <%- partial('_partial/reference-help', {search: "函数对象名称、功能分类、用途和配置参数。", usage: "先按后处理目标选择工具，再核对所需库、输入字段、作用区域、执行时机与输出设置；打开详情查看参数表和配置示例。"}) %>
<label class="search-field"><%- icon('search') %><input id="fo-query" type="search" aria-label="搜索函数对象" placeholder="输入名称、用途或参数，例如 probes、流量、patches…"></label>
  <div class="filter-tabs" role="group" aria-label="函数对象分类">
    <% ['全部', ...categories].forEach((category, index) => { %>
      <button type="button" data-fo-category="<%= category %>" class="<%= index === 0 ? 'selected' : '' %>" aria-pressed="<%= index === 0 %>"><%= category %></button>
    <% }); %>
  </div>
  <div class="fo-quick-results">
    <p class="result-count" id="fo-count" role="status">共 <%= entries.length %> 种功能对象</p>
    <label for="fo-sort">排序 <select id="fo-sort"><option value="common">常用优先</option><option value="name">名称 A–Z</option><option value="name-desc">名称 Z–A</option></select></label>
  </div>
  <div class="fo-quick-grid" id="fo-list" aria-label="功能对象列表"></div>
  <noscript><p>下列链接可直接打开各工具的参考页面。</p><ul><% entries.forEach(item => { %><li><a href="<%= item.url %>"><%= item.name %></a>：<%= item.description %></li><% }); %></ul></noscript>
</div>
