<% const data=interview_experience(),entries=data.entries,companies=[...new Set(entries.map(r=>r.company))],roles=[...new Set(entries.map(r=>r.role))],kinds=[...new Set(entries.map(r=>r.kind))]; %>
<div class="page-wrap experience-hub">
 <header class="page-heading"><div class="eyebrow">量化求职</div><h1>经验与求职</h1><p>按公司查阅面试记录和岗位要求，选择适合自己的准备路线。</p></header>
 <nav class="interview-books experience-modules" aria-label="经验与求职模块">
  <%- partial('_partial/interview-module-card',{card:{title:'经验与招聘',description:'按公司、岗位和类型查阅面试记录、招聘要求及准备重点。',tags:[entries.length+' 条记录','公司筛选','岗位筛选'],href:'#experience-records',action:'查看经验与招聘'}}) %>
  <%- partial('_partial/interview-module-card',{card:{title:'岗位介绍',description:'了解五类量化岗位的工作内容、技能要求和项目准备重点。',tags:['5 类岗位','技能要求','项目准备'],href:'#experience-roles',action:'了解岗位'}}) %>
  <%- partial('_partial/interview-module-card',{card:{title:'准备时间线',description:'按研究、开发或交易方向安排八周任务，并记录投递进度。',tags:['8 周安排','3 个方向','投递记录表'],href:'#experience-plan',action:'查看准备安排'}}) %>
  <%- partial('_partial/interview-module-card',{card:{title:'平台入口',description:'查找小红书、微信公众号等平台的量化求职经验，跳转阅读原帖。',tags:['小红书','微信公众号','公开网站'],href:'#experience-platforms',action:'查看平台入口'}}) %>
 </nav>
 <section id="experience-records" aria-labelledby="experience-heading">
  <h2 id="experience-heading">经验与招聘</h2>
  <div class="experience-filters"><label class="experience-search"><span class="sr-only">搜索经验与招聘</span><input id="experience-search" type="search" placeholder="搜索公司、岗位、面试主题或技能"></label><label>公司<select id="experience-company"><option value="">全部公司</option><% companies.forEach(x=>{ %><option><%= x %></option><% }) %></select></label><label>岗位<select id="experience-role"><option value="">全部岗位</option><% roles.forEach(x=>{ %><option><%= x %></option><% }) %></select></label><label>类型<select id="experience-kind"><option value="">全部类型</option><% kinds.forEach(x=>{ %><option><%= x %></option><% }) %></select></label><button type="button" class="button secondary" id="experience-reset">清除筛选</button></div>
  <p class="experience-note">个人记录标注了作者披露的时间；招聘条件以相应岗位页面为准。查阅日期：<%= data.checked %>。</p>
  <p id="experience-status" aria-live="polite"></p>
  <div class="lab-card-grid experience-grid"><% entries.forEach(r=>{ %>
   <article class="lab-card experience-card" data-experience-card data-company="<%= r.company %>" data-role="<%= r.role %>" data-kind="<%= r.kind %>"><div class="lab-card-body"><div class="experience-meta"><span><%= r.company %></span><span><%= r.kind %></span></div><h3><a href="<%= r.url %>" target="_blank" rel="noopener noreferrer"><%= r.title %></a></h3><p class="experience-source"><%= r.role %> · <%= r.platform %><% if(r.date){ %> · <%= r.date %><% } %></p><p><%= r.summary %></p><p class="experience-focus"><strong>准备重点</strong><%= r.focus %></p><a class="button secondary" href="<%= r.url %>" target="_blank" rel="noopener noreferrer"><%= r.kind==='个人经验'?'查看原帖':'查看详情' %> ↗</a></div></article>
  <% }) %></div><p class="lab-empty" id="experience-empty" hidden>没有匹配内容，可减少筛选条件。</p>
  <nav class="experience-pager" id="experience-pager" aria-label="经验列表翻页"></nav>
 </section>
 <section id="experience-roles"><h2>岗位介绍</h2><p>同一家公司的不同岗位，工作内容和面试重点可能相差很大。先看岗位职责，再决定练习的比例。</p><div class="lab-card-grid experience-role-grid">
  <article class="lab-card"><div class="lab-card-body"><span class="lab-meta">研究</span><h3>量化研究员</h3><p>从市场或业务问题提出假设，处理数据，构建信号，评价预测能力及组合表现。</p><ul><li>基础：概率统计、线性代数、回归与时间序列。</li><li>实现：Python 数据分析、可复现的训练与检验。</li><li>项目：解释数据可用时间、样本划分、对照方法、成本与失败结果。</li></ul><a href="/topics/factors/">学习截面因子研究 →</a></div></article>
  <article class="lab-card"><div class="lab-card-body"><span class="lab-meta">工程</span><h3>量化开发工程师</h3><p>将模型和行情接入研究或交易系统，处理性能、可靠性及数据一致性问题。</p><ul><li>基础：数据结构、操作系统、网络与并发。</li><li>实现：按岗位选择 C++、Python 或平台工具。</li><li>项目：说明接口、测试、故障处理，以及优化前后的测量方法。</li></ul><a href="/interview/practice/">查看公司题库 →</a></div></article>
  <article class="lab-card"><div class="lab-card-body"><span class="lab-meta">交易</span><h3>量化交易员</h3><p>围绕报价、仓位、执行和风险作出判断，监控策略并处理市场变化。</p><ul><li>基础：条件概率、期望、市场机制与风险。</li><li>练习：估算、报价、信息更新和仓位约束。</li><li>讨论：解释决策条件，以及新信息如何改变判断。</li></ul><a href="/theory/trading-and-exchanges/">学习交易与市场微观结构 →</a></div></article>
  <article class="lab-card"><div class="lab-card-body"><span class="lab-meta">模型</span><h3>机器学习研究员</h3><p>研究模型结构、训练目标、数据表达与泛化能力，并与金融任务的评价方式衔接。</p><ul><li>基础：优化、统计学习、深度学习。</li><li>实现：训练、调参、消融实验与计算效率。</li><li>项目：明确技术改进相对什么基线有效，避免把预测精度直接等同于收益。</li></ul><a href="/topics/ai/">学习人工智能专题 →</a></div></article>
  <article class="lab-card"><div class="lab-card-body"><span class="lab-meta">数据</span><h3>数据工程师</h3><p>维护数据接入、清洗、存储与计算过程，为研究和交易提供一致的数据。</p><ul><li>基础：SQL、数据库、数据模型与任务调度。</li><li>实现：增量同步、历史版本、质量检查与告警。</li><li>项目：说明重复、缺失、迟到和修订数据怎样处理。</li></ul><a href="/courses/?level=beginner">补充 Python 与数据基础 →</a></div></article>
 </div></section>
 <section id="experience-plan"><h2>准备时间线</h2><p>以下为投递前的八周安排，每周约 10—15 小时。已有基础可合并前两周；开始准备时就记录岗位截止日，开放申请后即可投递，无须等八周全部结束。</p>
  <div class="experience-track" role="group" aria-label="选择准备方向"><button type="button" class="button" data-plan-track="research" aria-pressed="true">研究方向</button><button type="button" class="button secondary" data-plan-track="development" aria-pressed="false">开发方向</button><button type="button" class="button secondary" data-plan-track="trading" aria-pressed="false">交易方向</button></div>
  <div id="experience-timeline" class="experience-timeline"></div>
  <noscript><p>第 1—2 周：明确岗位并补习基础；第 3—4 周：完成一项相关项目；第 5—6 周：限时练习和项目讨论；第 7—8 周：模拟面试、投递与复盘。</p></noscript>
  <div class="lab-card experience-application"><div class="lab-card-body"><h3>投递后的记录</h3><p>每个岗位单独记录投递日、笔试截止日、面试时间与时区、联系人、下一步和需要补习的内容。收到任务先确认可投入时间；有录用答复期限时，在安排后续面试前告知招聘联系人。</p><p>面试当天提前检查网络、摄像头和编程环境。面试后记录卡住的知识点与追问，补做一道同类题，修正项目说明。将失败原因落实到具体问题，便于调整下一周的训练。</p><a class="button secondary" href="/assets/downloads/interview-application-tracker.csv" download>↓ 下载投递记录表</a></div></div>
 </section>
 <section id="experience-platforms"><h2>平台入口</h2><p>小红书与公众号原帖可能需要在对应平台中打开。下列链接已在公开页面中找到，正文尚未直接核实，因此仅提供原帖入口。</p><div class="lab-card-grid experience-grid"><% data.platform_links.forEach(r=>{ %><article class="lab-card"><div class="lab-card-body"><span class="lab-meta"><%= r.company %> · <%= r.platform %></span><h3><%= r.title %></h3><p><%= r.description %></p><div class="fl-actions"><a class="button secondary" href="<%= r.url %>" target="_blank" rel="noopener noreferrer">打开原帖 ↗</a><a href="<%= r.discovery %>" target="_blank" rel="noopener noreferrer">查看收录页</a></div></div></article><% }) %></div><p class="experience-note">在微信中可搜索“九坤投资招聘”；在小红书中按“公司名＋岗位＋面经”检索，再核对发帖时间、实习或校招类型及地区。</p></section>
</div>
