<% const rows=static_catalog(page.section); %>
<div class="page-wrap lab-catalog-page" data-page-state="ready"><div class="eyebrow">学习资料</div><div class="catalog-header"><div class="page-heading"><h1><%= page.title %></h1><p><%= page.description %></p></div></div><label class="search-field catalog-search"><%- icon('search') %><input id="catalog-query" type="search" placeholder="搜索主题、标题或系列名称" aria-label="搜索内容"></label><p id="catalog-count" class="result-count" role="status"><%= rows.length %> 个条目</p><div class="lab-card-grid" data-static-catalog><% rows.forEach(r=>{ %><%- static_card(r) %><% }) %></div></div>
