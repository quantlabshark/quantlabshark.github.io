<% const data=learning(); %><div class="page-wrap"><div class="eyebrow">THE LEARNING PATH</div><div class="page-heading"><h1>OpenFOAM v2512 课程目录</h1><p>共 28 讲，每讲建议学习 90 分钟。各讲包含技术说明、操作示例与课后练习。</p></div><div class="stage-tabs"><% data.stages.forEach(s=>{ %><a href="#stage-<%= s.id %>">0<%= s.id %> <%= s.name %></a><% }); %></div><% data.stages.forEach(s=>{ %><section class="course-stage" id="stage-<%= s.id %>"><div class="course-stage-header"><span class="big-number">0<%= s.id %></span><div><h2><%= s.name %></h2><p><%= s.description %></p></div><span class="pill">第 <%= s.range %> 讲</span></div><div class="lesson-list"><% data.lessons.filter(l=>l.stage===s.id).forEach(l=>{ %><a href="<%= l.url %>" class="lesson-row" data-lesson-row="<%= l.id %>"><span class="lesson-num"><%= String(l.id).padStart(2,'0') %></span><div><h3><%= l.title %></h3><p><%= l.summary %></p></div><span class="lesson-duration">90 分钟</span><span class="completion-dot"></span><%- icon('arrow') %></a><% }); %></div></section><% }); %></div>
