<% const rows=theory_rows(page.theory_book),book=theory_book(page.theory_book); %>
<div class="page-wrap" data-theory-book="<%= page.theory_book %>">
 <div class="eyebrow">QUANTLAB · <%= book.kicker %></div>
 <div class="page-heading"><h1><%= book.title %></h1><p><%= book.description %></p></div>
 <div class="prose section-page-intro" data-section-page-body><p><%= book.introduction %></p><p><%= book.preparation %><a href="/read/?slug=<%= book.guide %>"><%= book.guide_title %></a>。</p></div>
 <div class="fvm-book-meta"><span id="theory-count"><%= book.chapters %> 章 · <%= rows.length %> 个阅读单元</span><span><%= book.extras %></span></div>
 <p class="theory-actions"><a class="button" id="theory-start" href="/read/?slug=<%= book.guide %>">开始阅读 →</a><a class="button secondary" href="<%= book.examples %>">下载配套 Python 示例</a></p>
 <div class="theory-toolbar"><label class="search-field"><%- icon('search') %><input id="theory-query" type="search" maxlength="100" placeholder="查找章节或概念，例如：<%= book.keywords %>" aria-label="查找<%= book.kicker %>课程"></label><button type="button" class="button secondary" id="theory-expand" aria-expanded="false">展开全部</button></div>
 <p id="theory-result" class="muted" role="status" aria-live="polite"><%= rows.length %> 个阅读单元</p>
 <div id="theory-catalog" data-lab-catalog="<%= book.key %>" data-catalog-custom><%- theory_catalog(page.theory_book) %></div>
 <p id="theory-empty" class="lab-empty" hidden>没有匹配的章节，请尝试其他关键词。</p><p id="theory-sync" class="muted" role="status"></p>
 <noscript><p>可直接浏览章节目录；搜索需要启用 JavaScript。</p></noscript>

</div>
