<% const item=page.item,rendered=static_body(item),parent=static_parent(item),siblings=static_siblings(item),index=siblings.findIndex(r=>r.slug===item.slug); %>
<div class="article-shell lab-reader<%= siblings.length?' has-chapters':'' %>">
 <aside class="article-toc reader-outline" aria-label="阅读导航"><% if(siblings.length){ %><details class="reader-chapters" id="reader-chapters"><summary>课程目录</summary><p class="chapter-series"><%= item.series||parent.label %></p><nav id="chapter-list" aria-label="课程章节"><% siblings.forEach(r=>{ %><a href="<%= static_url(r.slug) %>"<%- r.slug===item.slug?' aria-current="page"':'' %>><%= static_title(r) %></a><% }) %></nav></details><% } %><details class="reader-sections"><summary>本页目录</summary><nav id="toc"></nav></details></aside>
 <article class="article" id="static-article"><div class="eyebrow"><%= item.track||parent.label %></div><h1><%= static_title(item) %></h1><p class="lab-lead"><%= item.summary %></p><%- rendered.html %><%- rendered.downloads %>
 <% if(siblings.length){ %><nav class="lesson-navigation" aria-label="课程章节翻页"><div class="chapter-heading"><div><span><%= parent.label %></span><strong>第 <%= index+1 %> / <%= siblings.length %> 节</strong></div><a href="<%= parent.url %>">返回目录 →</a></div><div class="chapter-controls"><% const prev=siblings[index-1],next=siblings[index+1]; %><% if(prev){ %><a class="chapter-control" href="<%= static_url(prev.slug) %>">← 上一节</a><% }else{ %><span></span><% } %><% if(next){ %><a class="chapter-control" href="<%= static_url(next.slug) %>">下一节 →</a><% } %></div><div class="chapter-neighbors"><p><span>上一节</span><strong><%= prev?.title||'已是第一节' %></strong></p><p><span>下一节</span><strong><%= next?.title||'已是最后一节' %></strong></p></div></nav><% } %>
 </article>
</div>
<script type="application/json" id="static-article-data"><%- static_json({slug:item.slug,metadata:item.metadata,parent}) %></script>
